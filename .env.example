# Variables utilisées par docker-compose.yml
# Copiez ce fichier en ".env" à la racine et ajustez les valeurs avant de lancer `docker compose up`

POSTGRES_USER=transfertpro
POSTGRES_PASSWORD=transfertpro
POSTGRES_DB=transfertpro

FRONTEND_URL=http://localhost:8080

ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Example
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=00 0000000
ADMIN_PASSWORD=changeme

JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=24h

# Réinitialisation des données de test (opération destructive, voir RUNBOOK_PRODUCTION.md).
# Laisser à false en production : seule la valeur exacte "true" autorise l'API à
# supprimer les transferts, les encaissements et les comptes agents.
ENABLE_DATA_RESET=false
